---
import docs from 'le-kit/dist/docs.json';

interface Props {
	tag: string;
	/** Which part of the API to show — one per component page tab. */
	section: 'properties' | 'events' | 'slots' | 'styles';
}

const { tag, section } = Astro.props;

const component = docs.components.find((c: any) => c.tag === tag);

if (!component) {
  throw new Error(`Component ${tag} not found in docs.json`);
}

const props = component.props || [];
const events = component.events || [];
const slots = component.slots || [];
const cssProps = (component.docsTags || [])
  .filter((t: any) => t.name === 'cssprop')
  .map((t: any) => {
    // text usually formatted like "--var-name - Description"
    const parts = t.text.split(' - ');
    return { name: parts[0], docs: parts.slice(1).join(' - ') };
  });
const cssParts = component.parts || [];

/** Groups come from `@category` in the prop's JSDoc; this is their order. */
const CATEGORY_ORDER = ['Appearance', 'Content', 'State', 'Link & form', 'Motion', 'Toolbar', 'Actions', 'CMS'];
/** Props a container sets — shown last, closed. */
const CONTAINER_CATEGORY = 'Set by containers';

const docTag = (prop: any, name: string) => prop.docsTags?.find((t: any) => t.name === name)?.text;

/** Values as chips: enum values, or a kind for free values; booleans are flags. */
function describe(prop: any) {
  const def = prop.default ? String(prop.default).replace(/^'|'$/g, '') : undefined;
  const literals = (prop.values ?? []).filter((v: any) => v.value !== undefined).map((v: any) => v.value);
  const kinds = (prop.values ?? [])
    .filter((v: any) => v.value === undefined && v.type !== 'undefined')
    .map((v: any) => v.type);
  const flag = kinds.length === 1 && kinds[0] === 'boolean';
  return { def, literals, kinds: flag ? [] : kinds, flag };
}

/** JSDoc text as one paragraph with inline `code`. */
const docText = (text: string) =>
  (text ?? '')
    .replace(/\s*\n\s*/g, ' ')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

const grouped = new Map<string, any[]>();
for (const prop of props) {
  const category = docTag(prop, 'category') ?? 'Other';
  grouped.set(category, [...(grouped.get(category) ?? []), { prop, ...describe(prop) }]);
}
const rank = (c: string) => (c === CONTAINER_CATEGORY ? 99 : CATEGORY_ORDER.includes(c) ? CATEGORY_ORDER.indexOf(c) : 50);
const propGroups = [...grouped.entries()]
  .sort(([a], [b]) => rank(a) - rank(b) || a.localeCompare(b))
  .map(([title, items]) => ({ title, items, closed: title === CONTAINER_CATEGORY }));
const hasCategories = props.some((p: any) => docTag(p, 'category'));
---

<div class="api-tables">
	{section === 'properties' && props.length > 0 && (
		<section>
			{propGroups.map((group) => {
				const cardsList = (
					<div class="prop-cards">
						{group.items.map(({ prop, def, literals, kinds, flag }) => (
							<article class="prop-card" id={`@${prop.attr ?? prop.name}`}>
								<header>
									<code class="prop-attr">{prop.attr ?? prop.name}</code>
									{flag ? (
										<span class="prop-default">flag</span>
									) : (
										def && (
											<span class="prop-default">
												default <code>{def}</code>
											</span>
										)
									)}
								</header>
								<p class="prop-docs" set:html={docText(prop.docs)} />
								{(literals.length > 0 || kinds.length > 0) && (
									<div class="prop-values">
										{literals.map((v: string) => (
											<span class:list={['chip', { 'chip-default': v === def }]}>{v}</span>
										))}
										{kinds.map((k: string) => (
											<span class="chip chip-kind">{k}</span>
										))}
									</div>
								)}
								{prop.attr && prop.attr !== prop.name && (
									<footer>
										JS: <code>{prop.name}</code>
									</footer>
								)}
							</article>
						))}
					</div>
				);
				return group.closed ? (
					<details class="prop-group">
						<summary class="prop-group-title">{group.title}</summary>
						{cardsList}
					</details>
				) : (
					<div class="prop-group">
						{hasCategories && <h4 class="prop-group-title">{group.title}</h4>}
						{cardsList}
					</div>
				);
			})}
		</section>
	)}

	{section === 'events' && events.length > 0 && (
		<section>
			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th>Event</th>
							<th>Detail</th>
							<th>Description</th>
						</tr>
					</thead>
					<tbody>
						{events.map((event: any) => (
							<tr>
								<td><code>{event.event}</code></td>
								<td><code>{event.detail}</code></td>
								<td>{event.docs}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}

	{section === 'slots' && slots.length > 0 && (
		<section>
			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
						</tr>
					</thead>
					<tbody>
						{slots.map((slot: any) => (
							<tr>
								<td>{slot.name ? <code>{slot.name}</code> : <em>default</em>}</td>
								<td>{slot.docs}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}

	{section === 'styles' && cssProps.length > 0 && (
		<section>
			<h3 class="api-heading">CSS custom properties</h3>
			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
						</tr>
					</thead>
					<tbody>
						{cssProps.map((prop: any) => (
							<tr>
								<td><code>{prop.name}</code></td>
								<td>{prop.docs}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}
  
	{section === 'styles' && cssParts.length > 0 && (
		<section>
			<h3 class="api-heading">Parts</h3>
			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th>Part</th>
							<th>Description</th>
						</tr>
					</thead>
					<tbody>
						{cssParts.map((part: any) => (
							<tr>
								<td><code>{part.name}</code></td>
								<td>{part.docs}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}
</div>

<style>
	.api-tables section {
		margin-bottom: var(--le-spacing-xl);
	}
	
	.table-wrapper {
		overflow-x: auto;
		margin-top: var(--le-spacing-md);
	}
	
	table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		font-size: 0.9rem;
	}
	
	th, td {
		padding: var(--le-spacing-sm) var(--le-spacing-md);
		border-bottom: 1px solid var(--le-color-border);
	}
	
	th {
		background-color: var(--le-color-background-offset);
		font-weight: 600;
	}
	
	/* Properties: cards grouped by @category */
	.prop-group {
		margin-top: var(--le-spacing-4);
	}

	.prop-group-title {
		margin: 0 0 var(--le-spacing-2);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		opacity: 0.6;
	}

	summary.prop-group-title {
		cursor: pointer;
	}

	.prop-cards {
		display: grid;
		gap: var(--le-spacing-2);
	}

	.prop-card {
		padding: var(--le-spacing-3) var(--le-spacing-4);
		border-radius: var(--le-radius-lg);
		background: color-mix(in srgb, var(--le-color-surface-elevated, #fff), transparent 40%);
		box-shadow: var(--le-shadow-sm, 0 1px 2px rgba(0, 0, 0, 0.08));
		scroll-margin-top: calc(var(--le-header-height, 0px) + var(--le-spacing-4));
	}

	.prop-card header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--le-spacing-4);
	}

	.prop-attr {
		font-weight: 600;
		font-size: 0.95rem;
	}

	.prop-default {
		font-size: 0.8rem;
		opacity: 0.7;
	}

	.prop-docs {
		margin: var(--le-spacing-1) 0;
		font-size: 0.9rem;
	}

	.prop-values {
		display: flex;
		flex-wrap: wrap;
		gap: var(--le-spacing-1);
	}

	.chip {
		display: inline-block;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--le-color-border);
		font-family: var(--le-font-family-mono);
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.chip-default {
		background: var(--le-color-primary);
		border-color: var(--le-color-primary);
		color: var(--le-color-on-primary, #fff);
	}

	.chip-kind {
		border-style: dashed;
		opacity: 0.8;
	}

	.prop-card footer {
		margin-top: var(--le-spacing-1);
		font-size: 0.75rem;
		opacity: 0.55;
	}

	.prop-card :is(.prop-attr, .prop-default code, footer code, .prop-docs code) {
		padding: 0;
		background: none;
	}

	code {
		font-family: monospace;
		padding: 2px 4px;
		background-color: var(--le-color-background-offset);
		border-radius: 4px;
	}
</style>
