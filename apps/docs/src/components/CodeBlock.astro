---
/**
 * Highlighted code with a small toolbar: copy, and — when the code is longer
 * than `lines` — show all / show less. Collapsing is `le-collapse collapsed-size`;
 * the toolbar sticks to the bottom of the screen while an open block runs past it.
 */
import { codeToHtml } from "shiki";

interface Props {
  code: string;
  language?: string;
  title?: string;
  /** Lines shown while collapsed; longer code gets a "Show all" toggle. */
  lines?: number;
}

const { code, language = "html", title, lines = 12 } = Astro.props;

function trimSurroundingBlankLines(value: string): string {
  const all = value.split("\n");
  while (all.length > 0 && all[0].trim() === "") all.shift();
  while (all.length > 0 && all[all.length - 1].trim() === "") all.pop();
  return all.join("\n");
}

const normalizedCode = trimSurroundingBlankLines(code);
const totalLines = normalizedCode.split("\n").length;
const collapsible = totalLines > lines;
const collapseAttrs = collapsible
  ? { closed: "", "collapsed-size": `calc(${lines}lh + var(--code-block-pad) + var(--code-block-bar))` }
  : {};

const html = await codeToHtml(normalizedCode, { lang: language, theme: "plastic" });
---

<div class="code-block" data-code={encodeURIComponent(normalizedCode)} data-lines={totalLines}>
  {title && <div class="code-block__title">{title}</div>}
  <le-collapse class="code-block__body" {...collapseAttrs} set:html={html}></le-collapse>
  <div class="code-block__toolbar">
    <le-button size="small" variant="filled" color="secondary" view="idle" data-code-copy>
      <le-icon slot="icon-start" name="copy" view="idle"></le-icon>
      <le-icon slot="icon-start" name="check" view="done"></le-icon>
      <span view="idle">Copy</span>
      <span view="done">Copied</span>
    </le-button>
    {
      collapsible && (
        <le-button size="small" variant="filled" color="secondary" view="closed" data-code-toggle>
          <le-icon slot="icon-start" name="chevron-down" class="code-block__chevron"></le-icon>
          <span view="closed">Show all {totalLines} lines</span>
          <span view="open">Show less</span>
        </le-button>
      )
    }
  </div>
</div>

<script>
  // Delegated, so blocks inserted later (e.g. the playground's recipe switch) work too.
  type Collapse = HTMLElement & { closed: boolean };
  type WithView = HTMLElement & { view?: string };

  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;

    const toggle = target.closest<WithView>("[data-code-toggle]");
    if (toggle) {
      const block = toggle.closest<HTMLElement>(".code-block");
      const collapse = block?.querySelector<Collapse>("le-collapse");
      if (!block || !collapse) return;

      const closing = !collapse.closed;
      collapse.closed = closing;
      toggle.view = closing ? "closed" : "open";

      // Collapsing a block whose top is off-screen would leave the reader far below it.
      if (closing && block.getBoundingClientRect().top < 0) {
        block.scrollIntoView({ behavior: "smooth", block: "start" });
      }
      return;
    }

    const copy = target.closest<WithView>("[data-code-copy]");
    if (copy) {
      const block = copy.closest<HTMLElement>(".code-block");
      try {
        await navigator.clipboard.writeText(decodeURIComponent(block?.dataset.code ?? ""));
        copy.view = "done";
        setTimeout(() => (copy.view = "idle"), 2000);
      } catch (err) {
        console.error("Failed to copy code: ", err);
      }
    }
  });
</script>

<style>
  .code-block {
    /* Padding around the code, and room for the toolbar under the last line. */
    --code-block-pad: var(--le-spacing-3);
    --code-block-bar: 2.75rem;

    position: relative;
    margin: var(--le-spacing-4) 0;
    border: 2px solid var(--le-color-border);
    background-color: #213553;
    border-radius: var(--le-radius-md, 8px);
    scroll-margin-top: calc(var(--le-header-height, 0px) + var(--le-spacing-4));
  }

  .code-block__title {
    padding: var(--le-spacing-2) var(--le-spacing-4);
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom: 2px solid var(--le-color-border);
    font-family: var(--le-font-family-mono);
    font-size: var(--le-font-size-sm);
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
  }

  /* `lh` in collapsed-size is measured with these. */
  .code-block__body {
    --le-collapse-fade-size: var(--code-block-bar);
    font-size: var(--le-font-size-md);
    line-height: 1.4;
  }

  .code-block__body :global(pre) {
    margin: 0 !important;
    padding: var(--code-block-pad);
    padding-bottom: calc(var(--code-block-pad) + var(--code-block-bar));
    border: none !important;
    background-color: transparent !important;
    font-size: inherit;
    line-height: inherit;
  }

  .code-block__toolbar {
    position: sticky;
    bottom: var(--le-spacing-2);
    display: flex;
    justify-content: flex-end;
    gap: var(--le-spacing-2);
    margin-top: calc(-1 * var(--code-block-bar));
    padding: 0 var(--le-spacing-2) var(--le-spacing-2);
    pointer-events: none;
  }

  .code-block__toolbar > * {
    pointer-events: auto;
  }

  /* One chevron for both views: it turns instead of being swapped. */
  .code-block__chevron {
    transition: rotate var(--le-motion-view-duration) var(--le-motion-view-easing);
  }

  [view="open"] > .code-block__chevron {
    rotate: 180deg;
  }
</style>
