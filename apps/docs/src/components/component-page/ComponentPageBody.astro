---
/**
 * Generic component page: overview + Playground / API / Roadmap tabs.
 * Content comes from `packages/core/src/components/<tag>/<tag>.page.md`.
 */
import { getEntry, render } from "astro:content";
import ApiTable from "../ApiTable.astro";
import Stage from "./Stage.astro";
import CodeBlock from "../CodeBlock.astro";

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const entry = await getEntry("componentPages", tag);
if (!entry) throw new Error(`No page content for ${tag} (expected ${tag}.page.md next to the component)`);

const { tagline, hero, heroDirection, whenToUse, whenNotToUse, recipes } = entry.data;
const { Content } = await render(entry);
const recipe = recipes[0];

/** Inline `code` in short list items; everything else is escaped. */
const inline = (text: string) =>
  text
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
---

<header class="overview">
  <h1>&lt;{tag}&gt;</h1>
  <p class="tagline">{tagline}</p>

  <div class="overview-grid">
    <div class:list={["hero", `hero-${heroDirection}`]} set:html={hero} />
    <div class="when">
      <h2 class="when-title">When to use</h2>
      <ul>{whenToUse.map((item) => <li set:html={inline(item)} />)}</ul>
      <h2 class="when-title">When not to</h2>
      <ul>{whenNotToUse.map((item) => <li set:html={inline(item)} />)}</ul>
    </div>
  </div>
</header>

<le-tabs class="page-tabs" selected="playground" data-component-page-tabs>
  <le-tab-panel label="Playground" value="playground">
    <section class="playground" data-playground>
      <le-side-panel
        side="end"
        panel-id="recipes"
        panel-label="Recipes"
        panel-width="220"
        collapse-at="720"
        narrow-behavior="overlay"
        data-recipe-panel
      >
        <le-navigation
          slot="panel"
          orientation="vertical"
          active-url={`#recipe-${recipe.id}`}
          data-recipe-nav
        >
          {
            recipes.map((item) => (
              <le-item label={item.title} href={`#recipe-${item.id}`} data-recipe={item.id}></le-item>
            ))
          }
        </le-navigation>

        <div class="stage-area">
          <div class="stage-bar">
            <le-side-panel-toggle panel-id="recipes" variant="clear" size="small">
              <le-icon slot="icon-start" name="side-panel-end"></le-icon>
              Recipes
            </le-side-panel-toggle>
          </div>
          <Stage html={recipe.html} />
          <p class="recipe-note" data-recipe-note>
            <strong>{recipe.title}.</strong> {recipe.note}
          </p>
          <div class="code" data-code>
            <div class="code-clip" data-code-target>
              <CodeBlock language="html" code={recipe.html} />
            </div>
            <le-button variant="clear" size="small" class="code-toggle" data-code-toggle>
              Show all code
            </le-button>
          </div>
        </div>
      </le-side-panel>

      {
        recipes.map((item) => (
          <template
            data-recipe-template={item.id}
            data-title={item.title}
            data-note={item.note}
            set:html={item.html}
          ></template>
        ))
      }
      {
        recipes.map((item) => (
          <template data-recipe-code={item.id} data-lines={item.html.trim().split("\n").length}>
            <CodeBlock language="html" code={item.html} />
          </template>
        ))
      }
    </section>
  </le-tab-panel>

  <le-tab-panel label="API" value="api">
    <div class="notes"><Content /></div>
    <ApiTable tag={tag} />
  </le-tab-panel>

  <le-tab-panel label="Roadmap" value="roadmap">
    <p class="placeholder">Coming soon: what is wanted, in discussion, planned and rejected for this component.</p>
  </le-tab-panel>
</le-tabs>

<script>
  import { initComponentPageTabs, initRecipes } from "./tabs-client";

  const tabs = document.querySelector<HTMLElement>("[data-component-page-tabs]");
  const playground = document.querySelector<HTMLElement>("[data-playground]");
  const recipes = playground ? initRecipes(playground) : undefined;
  if (tabs) initComponentPageTabs(tabs, recipes);
</script>

<style>
  .tagline {
    font-size: 1.125rem;
    margin-top: 0;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--le-spacing-4);
    align-items: start;
    margin: var(--le-spacing-4) 0;
  }

  @media (max-width: 720px) {
    .overview-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--le-spacing-2);
    align-items: center;
    justify-content: center;
    padding: var(--le-spacing-6) var(--le-spacing-4);
    border-radius: var(--le-border-radius-lg, 12px);
    background: var(--le-color-surface-subtle, rgba(127, 127, 127, 0.08));
  }

  @media (min-width: 721px) {
    .hero-column {
      flex-direction: column;
    }
  }

  .when-title {
    font-size: 1rem;
    margin: 0 0 var(--le-spacing-1);
  }

  .when ul {
    margin: 0 0 var(--le-spacing-3);
    padding-left: 1.2em;
  }

  .page-tabs {
    display: block;
    margin-top: var(--le-spacing-4);
  }

  .playground {
    padding-top: var(--le-spacing-3);
  }

  .stage-area {
    min-width: 0;
  }

  .stage-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--le-spacing-2);
  }

  /* Code: clipped to ~3 lines until expanded */
  .code-clip {
    position: relative;
  }

  .code[data-clipped] .code-clip {
    max-height: 5.6em;
    overflow: hidden;
  }

  .code[data-clipped] .code-clip::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2em;
    background: linear-gradient(transparent, var(--le-color-background));
    pointer-events: none;
  }

  .code:not([data-has-more]) .code-toggle {
    display: none;
  }

  .recipe-note,
  .placeholder {
    opacity: 0.8;
  }
</style>
