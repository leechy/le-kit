---
/**
 * Generic component page: overview + Playground / API / Roadmap tabs.
 * Content comes from `packages/core/src/components/<tag>/<tag>.page.md`; notes for the
 * API tabs from `<tag>.properties.md`, `.events.md`, `.slots.md`, `.styles.md` next to it.
 */
import { getEntry, render } from "astro:content";
import docs from "le-kit/dist/docs.json";
import ApiTable from "../ApiTable.astro";
import Stage from "./Stage.astro";
import CodeBlock from "../CodeBlock.astro";

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const entry = await getEntry("componentPages", tag);
if (!entry) throw new Error(`No page content for ${tag} (expected ${tag}.page.md next to the component)`);

const { tagline, hero, heroDirection, heroWidth, whenToUse, whenNotToUse, recipes } = entry.data;

/** API tabs: a tab is shown only when it has entries or a note (`<tag>.<tab>.md`). */
const apiDocs: any = docs.components.find((c: any) => c.tag === tag) ?? {};
const apiTabs = await Promise.all(
  [
    { value: "properties", label: "Properties", count: apiDocs.props?.length ?? 0 },
    { value: "events", label: "Events", count: apiDocs.events?.length ?? 0 },
    { value: "slots", label: "Slots", count: apiDocs.slots?.length ?? 0 },
    {
      value: "styles",
      label: "Styles",
      count:
        (apiDocs.docsTags ?? []).filter((t: any) => t.name === "cssprop").length + (apiDocs.parts?.length ?? 0),
    },
  ].map(async (tab) => {
    const note = await getEntry("componentNotes", `${tag}/${tab.value}`);
    return {
      ...tab,
      Note: note ? (await render(note)).Content : undefined,
      examples: note?.data.examples ?? [],
    };
  }),
).then((tabs) => tabs.filter((tab) => tab.count > 0 || tab.Note));
const recipe = recipes[0];
/** The recipe select is at least as wide as its longest option. */
const longestRecipeTitle = Math.max(...recipes.map((item) => item.title.length));

/** Inline `code` in short list items; everything else is escaped. */
const inline = (text: string) =>
  text
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
---

<header class="overview">
  <h1>&lt;{tag}&gt;</h1>
  <p class="tagline">{tagline}</p>

  <div class="overview-grid" data-hero-width={heroWidth}>
    <div class:list={["hero", `hero-${heroDirection}`]} set:html={hero} />
    <div class="when">
      <h2 class="when-title">When to use</h2>
      <ul>{whenToUse.map((item) => <li set:html={inline(item)} />)}</ul>
      <h2 class="when-title">When not to</h2>
      <ul>{whenNotToUse.map((item) => <li set:html={inline(item)} />)}</ul>
    </div>
  </div>
</header>

<le-tabs class="page-tabs" selected="playground" data-component-page-tabs>
  <le-tab-panel label="Playground" value="playground">
    <section class="playground" data-playground>
      <le-side-panel
        side="end"
        panel-id="recipes"
        panel-label="Recipes"
        panel-width="220"
        collapse-at="720"
        narrow-behavior="overlay"
        data-recipe-panel
      >
        <div slot="panel" class="recipes-panel">
          <h3 class="recipes-title" id="recipes-title">Recipes</h3>
          <le-navigation
            orientation="vertical"
            active-url={`#recipe-${recipe.id}`}
            aria-labelledby="recipes-title"
            data-recipe-nav
          >
            {
              recipes.map((item) => (
                <le-item label={item.title} href={`#recipe-${item.id}`} data-recipe={item.id}></le-item>
              ))
            }
          </le-navigation>
        </div>

        <div class="stage-area">
          {/* Replaces the recipes panel whenever it is not shown next to the stage. */}
          <le-collapse
            class="recipe-switcher"
            closed
            closed-when="le-side-panel:state.visible"
            closed-when-target="recipes"
          >
            <div class="stage-bar">
              <span class="recipes-label">Recipes:</span>
              <div style={`min-width: calc(${longestRecipeTitle}ch + 4em)`}>
                <le-select
                  variant="outlined"
                  full-width
                  options={JSON.stringify(recipes.map((item) => ({ label: item.title, value: item.id })))}
                  value={recipe.id}
                  data-recipe-select
                ></le-select>
              </div>
            </div>
          </le-collapse>
          <Stage html={recipe.html} />
          <p class="recipe-note" data-recipe-note>
            <strong>{recipe.title}.</strong> {recipe.note}
          </p>
          <div data-code-target>
            <CodeBlock language="html" code={recipe.html} lines={3} />
          </div>
        </div>
      </le-side-panel>

      {
        recipes.map((item) => (
          <template
            data-recipe-template={item.id}
            data-title={item.title}
            data-note={item.note}
            set:html={item.html}
          ></template>
        ))
      }
      {
        recipes.map((item) => (
          <template data-recipe-code={item.id}>
            <CodeBlock language="html" code={item.html} lines={3} />
          </template>
        ))
      }
    </section>
  </le-tab-panel>

  {
    apiTabs.map(({ value, label, Note, examples }) => (
      <le-tab-panel label={label} value={value}>
        {Note && (
          <div class="notes">
            <Note />
          </div>
        )}
        <ApiTable
          tag={tag}
          section={value as "properties" | "events" | "slots" | "styles"}
          anatomy={entry.data.anatomy}
          examples={examples}
        />
      </le-tab-panel>
    ))
  }

  <le-tab-panel label="Roadmap" value="roadmap">
    <p class="placeholder">Coming soon: what is wanted, in discussion, planned and rejected for this component.</p>
  </le-tab-panel>
</le-tabs>

<script>
  import { initComponentPageTabs, initRecipes } from "./tabs-client";

  const tabs = document.querySelector<HTMLElement>("[data-component-page-tabs]");
  const playground = document.querySelector<HTMLElement>("[data-playground]");
  const recipes = playground ? initRecipes(playground) : undefined;
  if (tabs) initComponentPageTabs(tabs, recipes);
</script>

<style>
  .tagline {
    font-size: 1.125rem;
    margin-top: 0;
  }

  /* Source order is hero → text (what narrow screens and `full` show, text below);
     wide screens put the text first. The hero's share comes from `heroWidth`
     in the page.md: narrow | half (default) | wide | full. */
  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--le-spacing-4);
    align-items: start;
    margin: var(--le-spacing-4) 0;
  }

  @media (min-width: 721px) {
    .overview-grid[data-hero-width="narrow"] {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .overview-grid[data-hero-width="half"] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .overview-grid[data-hero-width="wide"] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }

    .overview-grid:not([data-hero-width="full"]) .when {
      order: -1;
    }
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--le-spacing-4);
    align-items: center;
    justify-content: center;
    padding: var(--le-spacing-6) var(--le-spacing-4);
    border-radius: var(--le-border-radius-lg, 12px);
    background: var(--le-color-surface-subtle, rgba(127, 127, 127, 0.08));
  }

  @media (min-width: 721px) {
    .hero-column {
      flex-direction: column;
    }
  }

  .when-title {
    font-size: 1rem;
    margin: 0 0 var(--le-spacing-1);
  }

  .when ul {
    margin: 0 0 var(--le-spacing-3);
    padding-left: 1.2em;
  }

  .page-tabs {
    display: block;
    margin-top: var(--le-spacing-4);
  }

  /* A visible container, so the recipes panel slides in from its edge. */
  .playground {
    background: color-mix(in srgb, var(--le-color-surface-elevated), transparent 60%);
    box-shadow: var(--le-shadow-md);
    /* Gap to the container edges (inline) or the screen edges (overlay); none on the
       content side — the stage area's own padding separates them. */
    --le-side-panel-margin: var(--le-spacing-3) var(--le-spacing-3) var(--le-spacing-3) 0;
  }

  /* Content keeps its own spacing whether the recipes panel is shown or not. */
  .stage-area {
    min-width: 0;
    padding: var(--le-spacing-3);
  }

  .stage-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--le-spacing-2);
    margin-bottom: var(--le-spacing-2);
  }

  /* "Recipes" names the list wherever it is: the panel or the select. */
  .recipes-title,
  .recipes-label {
    font-size: var(--le-font-size-lg, 1.125rem);
    font-weight: 600;
  }

  .recipes-title {
    margin: var(--le-spacing-2) var(--le-spacing-3) var(--le-spacing-1);
  }

  .recipe-note,
  .placeholder {
    opacity: 0.8;
  }
</style>
