---
import Layout from "./Layout.astro";
import { componentsNavigationItems, type NavItem } from "../data/navigation";

interface Props {
  title: string;
  pageType?: string;
}

const { title, pageType } = Astro.props;

const normalizeHref = (href: string) => href.replace(/\/$/, "") || "/";

const pathname = normalizeHref(Astro.url.pathname);
const isComponentsIndex = pathname === "/components";

const documentTitle = isComponentsIndex
  ? "Le-Kit Components"
  : `<${title}> ⁃ Le-Kit Component`;

const escapeAttribute = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");

const renderNavigationItems = (items: NavItem[]): string =>
  items
    .map((item) => {
      const attrs = [
        `label="${escapeAttribute(item.label)}"`,
        item.href ? `href="${escapeAttribute(item.href)}"` : "",
        item.id ? `id="${escapeAttribute(item.id)}"` : "",
        item.open ? "open" : "",
        item.href && pathname === normalizeHref(item.href) ? "selected" : "",
      ]
        .filter(Boolean)
        .join(" ");

      const children = item.children?.length
        ? renderNavigationItems(item.children)
        : "";
      return `<le-item ${attrs}>${children}</le-item>`;
    })
    .join("");

const navigationMarkup = renderNavigationItems(componentsNavigationItems);
---

<Layout title={documentTitle} sidePanelId="components-navigation">
  <le-side-panel
    panel-id="components-navigation"
    persist-key="components-panel"
    top="under-header"
    margin="var(--le-spacing-2)"
    collapse-at="900"
    collapse-behavior="overlay"
    show-close-button={false}
    sticky
    full-height
    resizable
  >
    <le-navigation
      slot="panel"
      orientation="vertical"
      activeUrl={pathname}
      toggle-position="end"
      auto-scroll
    >
      <Fragment set:html={navigationMarkup} />
    </le-navigation>

    <div class="content">
      {
        pageType === "index" ? (
          <main class="bento-page">
            <slot />
          </main>
        ) : (
          <article>
            <slot />
          </article>
        )
      }
    </div>
  </le-side-panel>

  <style>
    @media (min-width: 900px) {
      .content {
        padding: 0 0 0 var(--le-spacing-4);
      }
    }

    article,
    .bento-page {
      max-width: 1024px;
      margin: var(--le-spacing-4) auto;
      padding: 0 1rem;
    }
  </style>
</Layout>
